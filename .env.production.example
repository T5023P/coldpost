# ---------------------------------------------------------------------------
# Cold Post production environment (Oracle Always Free VM).
# Copy to .env.production on the server, fill in, then: chmod 600 .env.production
# This file is gitignored and must never be committed.
# ---------------------------------------------------------------------------

# === Database ===
# Supabase Postgres is used for identity + role lookup only. Business data
# stays in SQLite at DATA_DIR so the synchronous data layer is unchanged.
# Use the session pooler URI; the direct db.<ref>.supabase.co host is IPv6-only.
DATABASE_URL=

# === Application ===
PORT=4100
NODE_ENV=production
DATA_DIR=/app/data

# === Security ===
# Must match the value that encrypted the existing api_secrets rows.
# Generated automatically into DATA_DIR/app_secret when empty.
APP_SECRET=
SESSION_DAYS=14
COOKIE_SECURE=true
SEED_DEMO=false

# === Supabase Auth ===
SUPABASE_URL=
# Server-side verification key. Never prefix with VITE_.
SUPABASE_SECRET_KEY=

# === Browser origins allowed to call the API ===
CORS_ALLOWED_ORIGINS=https://coldpost.delivery,https://www.coldpost.delivery
FRONTEND_URL=https://coldpost.delivery

# === Local admin seed (SQLite only, optional in production) ===
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_NAME=
