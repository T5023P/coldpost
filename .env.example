# ---------------------------------------------------------------------------
# Cold Post environment template. Copy to .env and adjust. Never commit .env.
# ---------------------------------------------------------------------------

# === Database ===
# When DATABASE_URL is unset the app runs on local SQLite (development default).
# In production set the Supabase connection string (use the session pooler URI).
DATABASE_URL=

# === Application ===
PORT=4100
NODE_ENV=development
DATA_DIR=

# === Security ===
# AES-256-GCM key for provider credentials. Leave empty to auto-generate
# data/app_secret on first boot. Rotating it breaks existing encrypted values
# unless they are re-encrypted first.
APP_SECRET=
SESSION_DAYS=14
COOKIE_SECURE=false
SEED_DEMO=true

# === Seeded local admin (SQLite development only) ===
ADMIN_EMAIL=admin@coldpost.in
ADMIN_PASSWORD=change-me-before-first-boot
ADMIN_NAME=Founder

# === Supabase Auth (production login) ===
# Public values — also exposed to the browser through the VITE_* names below.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Server-side only. Never expose, never prefix with VITE_.
SUPABASE_SERVICE_ROLE_KEY=

# === Frontend build-time values (Vite) ===
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Base URL of the API when the frontend is hosted separately from the backend.
# Leave empty when the API is served from the same origin.
VITE_API_BASE_URL=

# === HTTP ===
# Comma-separated list of browser origins allowed to call the API.
CORS_ALLOWED_ORIGINS=
FRONTEND_URL=
