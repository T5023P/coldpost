# ---------------------------------------------------------------------------
# Cold Post environment template. Copy to .env and adjust.
# ---------------------------------------------------------------------------

# Password used to log in as the seeded admin account (first boot only).
# Change it inside Settings -> Users after the first sign-in.
ADMIN_EMAIL=admin@coldpost.in
ADMIN_PASSWORD=Coldpost@2026
ADMIN_NAME=Founder

# Secret used to encrypt provider API credentials at rest (AES-256-GCM).
# Leave empty to auto-generate one in data/app_secret on first boot.
APP_SECRET=

# Session lifetime in days.
SESSION_DAYS=14

# HTTP port for the API / production server.
PORT=4100

# Serve built web assets from web/dist (production). Dev uses Vite on 5173.
NODE_ENV=development

# Set to true when behind HTTPS so the session cookie is marked Secure.
COOKIE_SECURE=false

# Seed demo data on first boot (cities, stores, sample products, demo orders).
SEED_DEMO=true

# Where the SQLite database and uploads live. Defaults to ./data
DATA_DIR=
