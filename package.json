{
  "name": "coldpost",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Cold Post — production, procurement and fulfilment operations app",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "npm run typecheck && vite build --config web/vite.config.ts",
    "start": "tsx server/index.ts",
    "seed": "tsx server/seed.ts",
    "seed:reset": "tsx server/seed.ts --reset",
    "typecheck": "tsc --noEmit",
    "test": "tsx scripts/acceptance.ts",
    "test:reset": "tsx scripts/acceptance.ts --reset"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.2",
    "dotenv": "^18.0.10",
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
